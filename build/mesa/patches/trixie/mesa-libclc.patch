  libclang-cpp19-dev [amd64 arm64 armhf i386 loong64 powerpc ppc64 ppc64el riscv64 s390x sparc64 x32],
- libclc-19 [amd64 arm64 armhf i386 loong64 powerpc ppc64 ppc64el riscv64 s390x sparc64 x32],
- libclc-19-dev [amd64 arm64 armhf i386 loong64 powerpc ppc64 ppc64el riscv64 s390x sparc64 x32],
  libdisplay-info-dev [amd64 arm64 armhf i386 loong64 powerpc ppc64 ppc64el riscv64 s390x sparc64 x32],
  libdrm-dev (>= 2.4.134-3~),
  libelf-dev [amd64 arm64 armhf i386 loong64 powerpc ppc64 ppc64el riscv64 s390x sparc64 x32],
@@ -51,6 +49,7 @@
  linux-libc-dev (>= 2.6.31) [linux-any],
  llvm-19-dev [amd64 arm64 armhf i386 loong64 powerpc ppc64 ppc64el riscv64 s390x sparc64 x32],
  llvm-spirv-19 [amd64 arm64 armhf i386 loong64 ppc64el riscv64 x32],
+ mesa-libclc [amd64 arm64 armhf i386 loong64 powerpc ppc64 ppc64el riscv64 s390x sparc64 x32],
  meson (>= 1.7.0),
  pkgconf,
  python3,
@@ -283,7 +282,8 @@
